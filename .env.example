# ========================================
# Finance Assistant Environment Variables
# ========================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace all placeholder values with actual credentials
# 3. NEVER commit the .env file to version control
# 4. Store production secrets in AWS Secrets Manager
#
# ========================================

# Database Configuration
# PostgreSQL connection string (use AWS RDS endpoint for production)
DATABASE_URL=postgresql://user:password@localhost:5432/finance

# AWS Configuration
# In production, use IAM roles instead of access keys
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# SageMaker Configuration
SAGEMAKER_ENDPOINT=recommendation-model

# Kinesis Configuration
KINESIS_STREAM_NAME=user-payment-events

# JWT Secret Key
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=generate_a_secure_random_key_here

# Application Configuration
FLASK_ENV=development
# Use 0 for False, 1 for True (avoid string "False" which evaluates to True in Python)
FLASK_DEBUG=0

# API Gateway URL
API_GATEWAY_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com

# Plaid API Configuration (store in AWS Secrets Manager for production)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Security
# Enable HTTPS in production (use 0 for False, 1 for True)
FORCE_HTTPS=1

# Logging
LOG_LEVEL=INFO
